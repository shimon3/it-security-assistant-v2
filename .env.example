# Personal access token required by every /api route (at least 16 characters).
# Generate one with: openssl rand -hex 24
ACCESS_TOKEN=

# VirusTotal public API key (personal, non-commercial use only).
VIRUSTOTAL_API_KEY=

# Optional but recommended in production: shared rate-limit counters.
# Without them each Edge instance keeps its own counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
